# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENV VARS
#
# This file documents every env var the deployed app needs. Copy real values
# into your host's secret store (Fly: `fly secrets set KEY=...`,
# Vercel: project env, etc.). DO NOT check real values into source control.
#
# After populating your secret store, run `npm run launch-check` to verify
# everything is set and not still pointing at sandbox/test endpoints.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── App identity ─────────────────────────────────────────────────────────────
APP_BASE_URL=https://invoicechase.com

# 32-byte base64 key encrypting QBO refresh tokens at rest. Generate with:
#   npm run gen-secrets
APP_ENCRYPTION_KEY=__REPLACE_ME__

# Long random string used to authenticate cron callers. Generate with:
#   npm run gen-secrets
CRON_SECRET=__REPLACE_ME__

# Comma-separated emails that get the /admin dashboard.
ADMIN_EMAILS=you@invoicechase.com

# ── Persistence ──────────────────────────────────────────────────────────────
# Mounted volume path on the host. Fly mounts /data; matches Dockerfile.
DB_PATH=/data/app.db

# ── QuickBooks Online (production app) ───────────────────────────────────────
# Create a *production* app in https://developer.intuit.com/, swap from sandbox
# keys, and add ${APP_BASE_URL}/api/qbo/callback as a redirect URI.
QBO_ENVIRONMENT=production
QBO_CLIENT_ID=__REPLACE_ME__
QBO_CLIENT_SECRET=__REPLACE_ME__
QBO_REDIRECT_URI=https://invoicechase.com/api/qbo/callback

# ── Xero (optional alternative to QuickBooks) ────────────────────────────────
# Leave blank to keep Xero off. Each org chooses one source — QBO or Xero —
# in Settings. Create a production app at https://developer.xero.com/ and
# add ${APP_BASE_URL}/api/xero/callback as the OAuth redirect.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://invoicechase.com/api/xero/callback

# ── Jobber (optional FSM source) ─────────────────────────────────────────────
# Leave blank to keep Jobber off. Requires approval from
# https://developer.getjobber.com/ before live API access. Add
# ${APP_BASE_URL}/api/jobber/callback as the OAuth redirect.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://invoicechase.com/api/jobber/callback

# ── Stripe (live mode) ───────────────────────────────────────────────────────
# Live secret + restricted-account webhook signing secret.
# Connect platform mode must be enabled on the Stripe account.
STRIPE_SECRET_KEY=sk_live___REPLACE_ME__
STRIPE_WEBHOOK_SECRET=whsec___REPLACE_ME__
# The recurring price you created in Stripe ($49/mo). Must be a live-mode price.
STRIPE_PRICE_ID=price___REPLACE_ME__

# ── Twilio SMS (production number) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC__REPLACE_ME__
TWILIO_AUTH_TOKEN=__REPLACE_ME__
# Default sender if a tenant hasn't claimed their own number.
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Set to "true" once at least your largest customers have approved A2P 10DLC
# campaigns; this gates SMS sending until campaign_status='approved' on the
# org's a2p_registrations row.
REQUIRE_A2P=false

# ── Resend (email) ───────────────────────────────────────────────────────────
# DKIM/SPF/DMARC must be verified on the sending domain or receipts go to spam.
RESEND_API_KEY=re___REPLACE_ME__
RESEND_FROM_EMAIL=Invoice Chase <login@invoicechase.com>

# ── Anthropic (autopilot replies) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant___REPLACE_ME__

# ── Sentry (recommended) ─────────────────────────────────────────────────────
SENTRY_DSN=https://__REPLACE_ME__@o000000.ingest.sentry.io/000000
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Litestream backup (recommended) ──────────────────────────────────────────
# Set the replica URL to enable continuous SQLite backup to S3-compatible
# storage. Leave blank to disable. Suggested provider: Cloudflare R2.
#   s3://my-bucket/invoicechase
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── Mock toggles (DO NOT SET in production) ──────────────────────────────────
# Leaving these unset is correct. The launch-check refuses to pass if these
# are truthy because they bypass real billing/sms/qbo.
USE_MOCK_DATA=
USE_MOCK_SMS=
