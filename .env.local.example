# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# ── App secrets ────────────────────────────────────────────────────────────
# 32-byte key used to encrypt QBO tokens at rest. Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Public URL of this app. Used to build redirect URIs for OAuth + Stripe.
APP_BASE_URL=http://localhost:3000

# ── QuickBooks Online (Sandbox) ────────────────────────────────────────────
# Create an app at https://developer.intuit.com/, copy your sandbox keys,
# and add ${APP_BASE_URL}/api/qbo/callback to your redirect URIs.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# ── Stripe (Test mode) ─────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Create a recurring $49/month price in Stripe → copy the price ID (price_…)
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (test mode)
# or the dashboard webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Dev convenience ────────────────────────────────────────────────────────
# Set to "1" to render the dashboard with mock data instead of hitting QBO.
USE_MOCK_DATA=
