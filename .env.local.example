# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# ── App secrets ────────────────────────────────────────────────────────────
# 32-byte key used to encrypt QBO tokens at rest. Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── QuickBooks Online (Sandbox) ────────────────────────────────────────────
# Create an app at https://developer.intuit.com/, copy your sandbox keys,
# and add http://localhost:3030/api/qbo/callback to your redirect URIs.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3030/api/qbo/callback

# ── Dev convenience ────────────────────────────────────────────────────────
# Set to "1" to render the dashboard with mock data instead of hitting QBO.
# Useful for UI iteration without an Intuit account.
USE_MOCK_DATA=
