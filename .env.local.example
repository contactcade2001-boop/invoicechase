# Copy this file to .env.local and fill in real values.
# .env.local is gitignored.

# ── App secrets ────────────────────────────────────────────────────────────
# 32-byte key used to encrypt QBO tokens at rest. Generate with:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Public URL of this app. Used to build redirect URIs for OAuth + Stripe.
APP_BASE_URL=http://localhost:3000

# ── QuickBooks Online ──────────────────────────────────────────────────────
# Create an app at https://developer.intuit.com/, copy your sandbox keys,
# and add ${APP_BASE_URL}/api/qbo/callback to your redirect URIs.
# Flip QBO_ENVIRONMENT to "production" to hit the live API base URL.
QBO_ENVIRONMENT=sandbox
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback

# ── Xero (optional alternative to QuickBooks) ──────────────────────────────
# Create an app at https://developer.xero.com/, set the redirect URI to
# ${APP_BASE_URL}/api/xero/callback. Leave these blank to keep Xero off.
# When set, the Settings page exposes a "Connect Xero" option alongside QBO.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# ── Jobber (optional FSM source for field-service businesses) ──────────────
# Create an app at https://developer.getjobber.com/, set the redirect URI
# to ${APP_BASE_URL}/api/jobber/callback. Jobber requires approval for API
# access — apply via their developer portal before testing.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=http://localhost:3000/api/jobber/callback

# ── Stripe (Test mode) ─────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Create a recurring $49/month price in Stripe → copy the price ID (price_…)
STRIPE_PRICE_ID=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` (test mode)
# or the dashboard webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# https://resend.com/api-keys — leave blank in dev to keep magic links in console.
RESEND_API_KEY=
# Verified sender (e.g. "Invoice Chase <login@invoicechase.com>"). Required
# only when RESEND_API_KEY is set.
RESEND_FROM_EMAIL=

# ── Twilio SMS ─────────────────────────────────────────────────────────────
# https://www.twilio.com/console — your Account SID and Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender number you've claimed in Twilio (e.g. +14155551234)
TWILIO_FROM_NUMBER=

# ── Autopilot (Claude) ─────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys — required only when an org
# enables autopilot mode in /settings.
ANTHROPIC_API_KEY=

# ── Cron secret ────────────────────────────────────────────────────────────
# Long random string. Vercel Cron and any external scheduler must send
# this in the Authorization header (Bearer ${CRON_SECRET}) on /api/cron/*.
CRON_SECRET=

# ── Sentry (optional) ──────────────────────────────────────────────────────
# Set SENTRY_DSN to forward server errors to Sentry. Without it we just
# console.error. SENTRY_TRACES_SAMPLE_RATE controls performance sampling
# (default 0.1).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# ── Dev convenience ────────────────────────────────────────────────────────
# Set to "1" to render the dashboard with mock data instead of hitting QBO.
USE_MOCK_DATA=
# Set to "1" to log SMS messages to the server console instead of hitting Twilio.
USE_MOCK_SMS=
